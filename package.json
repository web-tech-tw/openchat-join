{
  "name": "openchat-join",
  "version": "1.0.0",
  "description": "OpenChat 加入驗證系統",
  "author": "Taiwan Web Technology Promotion Organization",
  "license": "MIT",
  "scripts": {
    "new-secret": "bun new_secret.ts",
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "lint": "eslint src test new_secret.ts --ext .ts",
    "lint:es:fix": "eslint src test new_secret.ts --ext .ts --fix",
    "test": "bun test",
    "cover": "bun test --coverage",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{js,ts}": "eslint"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "dotenv": "^16.0.3",
    "elysia": "1.4.28",
    "geoip-lite": "^1.4.10",
    "http-status-codes": "^2.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.3",
    "node-cache": "^5.1.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.5.0",
    "@commitlint/config-conventional": "^17.4.4",
    "@types/bun": "^1.3.13",
    "@types/geoip-lite": "^1.4.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.17.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-jsdoc": "^50.4.3",
    "husky": "^8.0.1",
    "lint-staged": "^13.2.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
